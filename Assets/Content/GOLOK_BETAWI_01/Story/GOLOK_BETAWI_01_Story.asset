  m_Script: {fileID: 11500000, guid: e25fd6c8569d03541b047df14ede99d2, type: 3}
  m_Name: GOLOK_BETAWI_01_Story
  m_EditorClassIdentifier: NusantaraAR.Runtime::NusantaraAR.ArtifactStory
  chapters:
  - key: pembuka
    title:
      id: Pusaka dari Tanah Betawi
      en: Heritage of the Betawi People
    text:
      id: Inilah Golok Betawi, senjata tradisional sekaligus lambang jati diri masyarakat
        Jakarta. Pada tahun 2021, Kementerian Pendidikan dan Kebudayaan menetapkannya
        sebagai Warisan Budaya Takbenda Indonesia. Bagi warga Betawi, golok bukan
        sekadar benda tajam, melainkan simbol keberanian, kehormatan, dan tanggung
        jawab menjaga keluarga.
      en: This is the Golok Betawi, a traditional blade and proud emblem of Jakarta's
        Betawi community. In 2021, Indonesia's Ministry of Education and Culture
        recognized it as an Intangible Cultural Heritage. To the Betawi people, a
        golok is never just a cutting tool, but a symbol of courage, honor, and the
        duty to protect one's family.
    stage: 0
    focusHotspot: 
    voiceID: {fileID: 8300000, guid: c2d334e8942d80e45b2a4c0f496c0f9c, type: 3}
    voiceEN: {fileID: 8300000, guid: 4d859ba4b9c3e5b4a863359fe6692622, type: 3}
    cuesID:
    - time: 0
      text: Inilah Golok Betawi, senjata tradisional sekaligus lambang jati diri
        masyarakat Jakarta.
    - time: 7.936
      text: Pada tahun 2021, Kementerian Pendidikan dan Kebudayaan menetapkannya
        sebagai Warisan Budaya Takbenda Indonesia.
    - time: 18.176
      text: Bagi warga Betawi, golok bukan sekadar benda tajam, melainkan simbol
        keberanian, kehormatan, dan tanggung jawab menjaga keluarga.
    cuesEN:
    - time: 0
      text: This is the Golok Betawi, a traditional blade and proud emblem of Jakarta's
