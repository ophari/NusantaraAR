  m_Script: {fileID: 11500000, guid: deaae056f5a3ccf4d8025ecf14452651, type: 3}
  m_Name: KERIS_SUMATRA_01
  m_EditorClassIdentifier: NusantaraAR.Runtime::NusantaraAR.ArtifactData
  artifactId: KERIS_SUMATRA_01
  displayName:
    id: Keris Sumatra
    en: Sumatran Keris
  localName: Keris
  category: 0
  region:
    id: Sumatra
    en: Sumatra
  era:
    id: Era belum ditentukan
    en: Era not yet determined
  summary:
    id: Keris gaya Sumatra dengan bilah 7 luk berpamor wos wutah, hulu kayu burl
      berukir yang melengkung seperti kepala burung, warangka sampir bulan sabit,
      dan pendok kuningan berukir. Model dibuat di Blender dari cetak biru, bukan
      dipindai dari spesimen.
    en: A Sumatran-style keris with a 7-wave wos wutah patterned blade, a carved
      burl-wood hilt curving like a bird's head, a crescent sampir sheath top and
      engraved brass pendok. The model was made in Blender from a blueprint, not
      scanned from a specimen.
  thumbnail: {fileID: 2800000, guid: a49ba608f16da4940bc6f262c3280901, type: 3}
  prefab: {fileID: 2629085558189227531, guid: 29953468d927d82479fa8e51248fab6d, type: 3}
  specimenOwner: 
  collectionNumber: 
  license: Model Blender milik proyek (dibuat dari cetak biru)
  measurementNote:
    id: "Skala 1:1 mengikuti cetak biru: bilah 36 cm + pesi 7,2 cm, hulu \xB110 cm,
      warangka sampir lebar 19 cm. Bukan hasil pengukuran spesimen."
    en: '1:1 scale follows the blueprint: 36 cm blade + 7.2 cm tang (pesi), ~10 cm
      hilt, 19 cm wide sampir. Not measured from a specimen.'
  markerCode: 61668
  isPlaceholder: 1
  placeholderNote:
    id: 'Model Blender dari cetak biru: ukiran, motif pamor, dan serat kayu adalah
      penyederhanaan. Akan diganti aset dari spesimen asli yang divalidasi kurator.'
    en: 'Blender model from a blueprint: the carving, pamor pattern and wood grain
      are simplified. It will be replaced by an asset from a curator-validated specimen.'
  hotspots:
  - hotspotId: hulu
    partName: Hulu
    localPosition: {x: 0.0119999945, y: 0.06999999, z: -0.013464928}
    visibleFrom: 0
    title:
      id: Hulu (Deder)
      en: Hilt (Deder)
    regionalTerm: 'Sumatra/Semenanjung: hulu, deder'
    material:
      id: 'Pada model: kayu burl (jati berpola) berpernis (sesuai cetak biru, perlu
        dikonfirmasi)'
      en: 'On the model: varnished burl (figured teak) wood (per the blueprint, to
        be confirmed)'
    philosophy:
      id: '[Draf] Diisi kurator setelah spesimen asli ditetapkan.'
      en: '[Draft] To be written by the curator once the real specimen is chosen.'
    craft:
      id: Pegangan keris yang dipasang pada pesi. Bentuknya melengkung seperti pistol
        dengan kepala bergaya paruh burung; bagian bawahnya diukir motif sulur dan
        bunga.
      en: The keris handle, fitted onto the pesi. It curves like a pistol grip with
        a stylised bird-beak head; the lower part is carved with scroll and flower
        motifs.
    history:
      id: '[Draf] Diisi kurator setelah spesimen asli ditetapkan.'
      en: '[Draft] To be written by the curator once the real specimen is chosen.'
