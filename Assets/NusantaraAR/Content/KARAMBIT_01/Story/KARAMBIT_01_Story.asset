  m_Name: KARAMBIT_01_Story
  m_EditorClassIdentifier: NusantaraAR.Runtime::NusantaraAR.ArtifactStory
  chapters:
  - key: sapa
    title:
      id: Kenalan dulu
      en: Say hello
    text:
      id: Halo! Kali ini kita berkenalan dengan senjata kecil dari Minangkabau, Sumatra
        Barat. Orang Minang menyebutnya kurambiak atau karambiak, dan dalam bahasa
        Indonesia kita mengenalnya sebagai kerambit atau karambit. Ukurannya hanya
        segenggam tangan, tetapi ceritanya panjang.
      en: Hi! This time we'll meet a small weapon from Minangkabau, in West Sumatra.
        The Minang people call it kurambiak or karambiak, and in Indonesian it is
        known as kerambit or karambit. It is only as big as a hand, but its story
        is a long one.
    stage: 0
    focusHotspot: 
    voiceID: {fileID: 8300000, guid: 21c8ba3de1cf21d439895b538d1584ac, type: 3}
    voiceEN: {fileID: 8300000, guid: 0f80394e01db51245925a2212dbdc221, type: 3}
    cuesID:
    - time: 0.1
      text: Halo!
    - time: 1.834
      text: Kali ini kita berkenalan dengan senjata kecil dari Minangkabau, Sumatra
        Barat.
    - time: 8.357
      text: Orang Minang menyebutnya kurambiak atau karambiak, dan dalam bahasa Indonesia
        kita mengenalnya sebagai kerambit atau karambit.
    - time: 17.693
      text: Ukurannya hanya segenggam tangan, tetapi ceritanya panjang.
    cuesEN:
    - time: 0.1
      text: Hi!
    - time: 0.922
      text: This time we'll meet a small weapon from Minangkabau, in West Sumatra.
    - time: 5.089
